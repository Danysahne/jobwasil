# Bundesagentur für Arbeit job search API key (public: jobboerse-jobsuche)
BUNDES_API_KEY=jobboerse-jobsuche

# Anthropic API key for German→Arabic translation (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Shared access code — when set, every /api request must send it
# as the X-Access-Code header. Leave unset for open local development.
ACCESS_CODE=

# Comma-separated allowed CORS origins, e.g. https://jobwasil.example.com
# Leave unset to allow all origins (local development).
ALLOWED_ORIGINS=

# Server port (default 3000; the app expects 3001 in local dev)
PORT=3001

# Path to the exported Expo web build, relative to this directory.
# When set, the proxy also serves the web app (single-service hosting).
# Create the build with: npx expo export --platform web
WEB_BUILD_DIR=../dist
